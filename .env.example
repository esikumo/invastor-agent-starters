# Documentation only: scripts do not automatically load this file.
# Basic sandbox examples need only this public URL.
INVASTOR_API_BASE=https://invastor.com/api/

# Optional read-only monitor: use the ORIGINAL approved connection and purchase.
# Set exactly one of PURCHASE_ID or PURCHASE_KEY, never both.
# INVASTOR_CLIENT_ID=my-marketplace-agent
# PURCHASE_ID=123
# PURCHASE_KEY=original-operation-key

# Do not put wallet keys, bearer tokens or connection-store contents in this file.
# Live buyer settings are deliberately not enabled here; read the commerce guide.
